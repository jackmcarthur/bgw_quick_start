&control
   calculation = 'scf'
   prefix = 'GaSb'
   pseudo_dir = './'
   verbosity = 'high'
   max_seconds = 1785
/
&system
   ecutwfc = 80.0
   ibrav = 0
   nat = 8
   ntyp = 2
   nspin = 4
   nbnd = 114
   lspinorb = .true.
   noncolin = .true.
/
&electrons
   diago_full_acc = .false.
   electron_maxstep = 500
   conv_thr = 1e-10
   mixing_mode = 'plain'
   diagonalization = 'david'
   mixing_beta = 0.2
   mixing_ndim = 10
/
&ions
/
&cell
/
